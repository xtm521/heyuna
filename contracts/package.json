{
  "name": "@heyuna/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
