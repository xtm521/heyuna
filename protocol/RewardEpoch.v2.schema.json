{
  "$defs": {
    "NetworkBinding": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "enum": [
            297011,
            297012
          ],
          "title": "Chain Id",
          "type": "integer"
        },
        "genesis_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Genesis Hash",
          "type": "string"
        },
        "reward_vault_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Reward Vault Address",
          "type": "string"
        },
        "network_domain": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Network Domain",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "genesis_hash",
        "reward_vault_address",
        "network_domain"
      ],
      "title": "NetworkBinding",
      "type": "object"
    },
    "RewardAllocation": {
      "additionalProperties": false,
      "properties": {
        "recipient": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Recipient",
          "type": "string"
        },
        "amount": {
          "pattern": "^[0-9]+$",
          "title": "Amount",
          "type": "string"
        },
        "category": {
          "enum": [
            "training",
            "validation"
          ],
          "title": "Category",
          "type": "string"
        },
        "receipt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Receipt Ids",
          "type": "array"
        }
      },
      "required": [
        "recipient",
        "amount",
        "category",
        "receipt_ids"
      ],
      "title": "RewardAllocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2,
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "network": {
      "$ref": "#/$defs/NetworkBinding"
    },
    "epoch": {
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "state": {
      "const": "draft_pending_review",
      "default": "draft_pending_review",
      "title": "State",
      "type": "string"
    },
    "budget_wei": {
      "title": "Budget Wei",
      "type": "string"
    },
    "allocated_wei": {
      "title": "Allocated Wei",
      "type": "string"
    },
    "allocations": {
      "items": {
        "$ref": "#/$defs/RewardAllocation"
      },
      "title": "Allocations",
      "type": "array"
    },
    "manifest_hash": {
      "default": "",
      "title": "Manifest Hash",
      "type": "string"
    },
    "notice": {
      "default": "Native-chain unsigned draft only. No legacy receipt conversion and no payment.",
      "title": "Notice",
      "type": "string"
    }
  },
  "required": [
    "network",
    "epoch",
    "budget_wei",
    "allocated_wei",
    "allocations"
  ],
  "title": "RewardEpochV2",
  "type": "object"
}
