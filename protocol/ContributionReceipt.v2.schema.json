{
  "$defs": {
    "ContributionState": {
      "enum": [
        "computed",
        "pending_verification",
        "verified",
        "rejected",
        "pending_settlement",
        "claimable",
        "confirmed"
      ],
      "title": "ContributionState",
      "type": "string"
    },
    "NetworkBinding": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "enum": [
            297011,
            297012
          ],
          "title": "Chain Id",
          "type": "integer"
        },
        "genesis_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Genesis Hash",
          "type": "string"
        },
        "reward_vault_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Reward Vault Address",
          "type": "string"
        },
        "network_domain": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Network Domain",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "genesis_hash",
        "reward_vault_address",
        "network_domain"
      ],
      "title": "NetworkBinding",
      "type": "object"
    },
    "VerificationReference": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "chain_receipt_id": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Chain Receipt Id",
          "type": "string"
        },
        "adapter_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Hash",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "chain_receipt_id",
        "adapter_hash"
      ],
      "title": "VerificationReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Task Id",
      "type": "string"
    },
    "round_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Round Id",
      "type": "string"
    },
    "participant_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,80}$",
      "title": "Participant Id",
      "type": "string"
    },
    "wallet": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Wallet",
      "type": "string"
    },
    "task_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Hash",
      "type": "string"
    },
    "adapter_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Hash",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ContributionState"
    },
    "work_units": {
      "minimum": 1,
      "title": "Work Units",
      "type": "integer"
    },
    "validator_ids": {
      "items": {
        "type": "string"
      },
      "title": "Validator Ids",
      "type": "array"
    },
    "detail": {
      "default": "Off-chain v2 receipt only; chain commitment, finalization and claim are separate actions.",
      "title": "Detail",
      "type": "string"
    },
    "version": {
      "const": 2,
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "network": {
      "$ref": "#/$defs/NetworkBinding"
    },
    "model_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Model Hash",
      "type": "string"
    },
    "data_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Data Hash",
      "type": "string"
    },
    "template_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Template Hash",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "category": {
      "enum": [
        0,
        1
      ],
      "title": "Category",
      "type": "integer"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification_evidence_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Evidence Hash"
    }
  },
  "required": [
    "receipt_id",
    "task_id",
    "round_id",
    "participant_id",
    "wallet",
    "task_hash",
    "adapter_hash",
    "state",
    "work_units",
    "network",
    "model_hash",
    "data_hash",
    "template_hash",
    "config_hash",
    "category"
  ],
  "title": "ContributionReceiptV2",
  "type": "object"
}
